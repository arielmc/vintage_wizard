rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User's own inventory - authenticated users can read/write their own data
    // Public users can READ inventory (for shared links) but not write
    match /artifacts/{appId}/users/{userId}/inventory/{itemId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's inventory sub-collections (images_ai, etc.)
    match /artifacts/{appId}/users/{userId}/inventory/{itemId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User settings and other user documents
    match /artifacts/{appId}/users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shared collections - anyone can read, authenticated users can write
    match /artifacts/{appId}/shares/{shareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Shared individual items - anyone can read, authenticated users can write
    match /artifacts/{appId}/item_shares/{itemShareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
