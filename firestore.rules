rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User's own inventory - authenticated users can read/write their own data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shared collections - anyone can read, authenticated users can write
    match /artifacts/{appId}/shares/{shareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Shared individual items - anyone can read, authenticated users can write
    match /artifacts/{appId}/item_shares/{itemShareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

